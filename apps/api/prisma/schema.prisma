generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum ApiKeyProvider {
  ANTHROPIC
  OPENAI
}

enum AgentRole {
  EXEC_ASSISTANT
  RESEARCH_ANALYST
  CONTENT_WRITER
  SALES_PROSPECTOR
  OPS_COORDINATOR
}

enum AgentStatus {
  IDLE
  WORKING
  BLOCKED
  OFFLINE
}

enum AvatarStyle {
  PROFESSIONAL
  CREATIVE
  CASUAL
  EXECUTIVE
}

enum AvatarPresentation {
  FEMININE
  MASCULINE
  NEUTRAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  NEEDS_APPROVAL
  COMPLETE
  FAILED
  CANCELLED
}

enum TaskComplexity {
  SIMPLE
  MEDIUM
  COMPLEX
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  FAILED
  SKIPPED
}

enum ToolCallStatus {
  PENDING
  COMPLETE
  FAILED
}

enum MemoryType {
  SHORT_TERM
  LONG_TERM
}

enum IntegrationProvider {
  GMAIL
  GOOGLE_CALENDAR
  SLACK
  NOTION
  LINEAR
}

enum CreditReason {
  MONTHLY_GRANT
  PURCHASE
  TASK_CONSUMPTION
  REFUND
  GIFT
  SIGNUP_BONUS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EDITED
  CANCELLED
  EXPIRED
}

enum EventType {
  TASK_ASSIGNED
  STEP_STARTED
  TOOL_CALLED
  TOOL_RESULT
  NEEDS_APPROVAL
  APPROVAL_GRANTED
  STEP_COMPLETE
  TASK_COMPLETE
  TASK_FAILED
  TASK_BLOCKED
}

enum OfficeTheme {
  LOFT
  TRADITIONAL
  MODERN
}

enum AmbientSound {
  CITY
  QUIET
  RAIN
  COFFEE_SHOP
}

// ─── MODELS ───────────────────────────────────────────────────────

model User {
  id               String          @id @default(uuid())
  clerkId          String          @unique
  email            String          @unique
  name             String
  avatarUrl        String?
  plan             Plan            @default(FREE)
  byokKey          String?
  byokProvider     ApiKeyProvider?
  creditsRemaining Int             @default(25)
  onboardingDone   Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  office           Office?
  agents           Agent[]
  tasks            Task[]
  integrations     Integration[]
  creditLedger     CreditEntry[]
  savedCommands    SavedCommand[]
  scheduledRuns    ScheduledRun[]

  @@index([clerkId])
  @@index([email])
}

model Office {
  id           String       @id @default(uuid())
  userId       String       @unique
  name         String       @default("My Office")
  theme        OfficeTheme  @default(LOFT)
  city         String       @default("NYC")
  ambientSound AmbientSound @default(CITY)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents       Agent[]
}

model Agent {
  id                 String             @id @default(uuid())
  officeId           String
  userId             String
  name               String
  role               AgentRole
  systemPrompt       String             @db.Text
  contextBrief       String?            @db.Text
  personality        String?
  avatarUrl          String
  avatarStyle        AvatarStyle
  avatarPresentation AvatarPresentation
  deskPosition       Json
  status             AgentStatus        @default(IDLE)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  office             Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks              Task[]
  memories           AgentMemory[]
  events             TaskEvent[]
  approvalRequests   ApprovalRequest[]
  savedCommands      SavedCommand[]

  @@index([userId])
  @@index([officeId])
  @@index([status])
}

model Task {
  id              String          @id @default(uuid())
  agentId         String
  userId          String
  title           String
  rawCommand      String          @db.Text
  status          TaskStatus      @default(PENDING)
  complexity      TaskComplexity  @default(MEDIUM)
  result          Json?
  tokensUsed      Int             @default(0)
  costUsd         Float           @default(0)
  modelUsed       String?
  langGraphThread String?         @unique
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  agent           Agent           @relation(fields: [agentId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  steps           TaskStep[]
  events          TaskEvent[]
  toolCalls       ToolCall[]
  approvalRequests ApprovalRequest[]
  creditEntries   CreditEntry[]

  @@index([userId])
  @@index([agentId])
  @@index([status])
  @@index([createdAt])
}

model TaskStep {
  id          String     @id @default(uuid())
  taskId      String
  stepNumber  Int
  name        String
  description String?
  status      StepStatus @default(PENDING)
  input       Json?
  output      Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  toolCalls   ToolCall[]

  @@unique([taskId, stepNumber])
  @@index([taskId])
}

model TaskEvent {
  id             String    @id @default(uuid())
  taskId         String
  agentId        String
  eventType      EventType
  sequenceNumber Int
  payload        Json
  timestamp      DateTime  @default(now())

  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent          Agent     @relation(fields: [agentId], references: [id])

  @@index([taskId, sequenceNumber])
  @@index([agentId])
}

model ToolCall {
  id            String         @id @default(uuid())
  taskId        String
  taskStepId    String?
  integrationId String?
  toolName      String
  input         Json
  output        Json?
  status        ToolCallStatus @default(PENDING)
  retryCount    Int            @default(0)
  durationMs    Int?
  createdAt     DateTime       @default(now())
  completedAt   DateTime?

  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  step          TaskStep?      @relation(fields: [taskStepId], references: [id])
  integration   Integration?   @relation(fields: [integrationId], references: [id])

  @@index([taskId])
  @@index([taskStepId])
}

model AgentMemory {
  id         String     @id @default(uuid())
  agentId    String
  key        String
  value      String     @db.Text
  memoryType MemoryType @default(LONG_TERM)
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  agent      Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
  @@index([agentId])
  @@index([expiresAt])
}

model Integration {
  id                   String              @id @default(uuid())
  userId               String
  provider             IntegrationProvider
  accessToken          String              @db.Text
  refreshToken         String?             @db.Text
  tokenExpiresAt       DateTime?
  scopes               String[]
  isActive             Boolean             @default(true)
  composioConnectionId String?             @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCalls            ToolCall[]

  @@unique([userId, provider])
  @@index([userId])
}

model ApprovalRequest {
  id            String         @id @default(uuid())
  taskId        String
  agentId       String
  action        String
  preview       Json
  previewType   String
  isDestructive Boolean        @default(true)
  status        ApprovalStatus @default(PENDING)
  userEdit      Json?
  requestedAt   DateTime       @default(now())
  respondedAt   DateTime?
  expiresAt     DateTime

  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent         Agent          @relation(fields: [agentId], references: [id])

  @@index([taskId])
  @@index([status])
  @@index([expiresAt])
}

model SavedCommand {
  id          String   @id @default(uuid())
  userId      String
  agentId     String
  title       String
  rawCommand  String   @db.Text
  runCount    Int      @default(1)
  lastRunAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  schedules   ScheduledRun[]

  @@unique([userId, rawCommand])
  @@index([userId])
  @@index([agentId])
}

model ScheduledRun {
  id             String    @id @default(uuid())
  userId         String
  savedCommandId String
  cronExpr       String
  label          String
  isActive       Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime  @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedCommand   SavedCommand @relation(fields: [savedCommandId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model CreditEntry {
  id          String       @id @default(uuid())
  userId      String
  taskId      String?
  amount      Int
  reason      CreditReason
  description String
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
