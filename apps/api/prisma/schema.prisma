generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum ApiKeyProvider {
  ANTHROPIC
  OPENAI
  GEMINI
}

enum AgentRole {
  EXEC_ASSISTANT
  RESEARCH_ANALYST
  CONTENT_WRITER
  SALES_PROSPECTOR
  OPS_COORDINATOR
  FINANCIAL_ANALYST
  HR_MANAGER
  CUSTOMER_SUPPORT
  DATA_ANALYST
  MARKETING_STRATEGIST
}

enum AgentStatus {
  IDLE
  WORKING
  BLOCKED
  OFFLINE
}

enum AvatarStyle {
  PROFESSIONAL
  CREATIVE
  CASUAL
  EXECUTIVE
}

enum AvatarPresentation {
  FEMININE
  MASCULINE
  NEUTRAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  NEEDS_APPROVAL
  COMPLETE
  FAILED
  CANCELLED
}

enum TaskComplexity {
  SIMPLE
  MEDIUM
  COMPLEX
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  FAILED
  SKIPPED
}

enum ToolCallStatus {
  PENDING
  COMPLETE
  FAILED
}

enum MemoryType {
  SHORT_TERM
  LONG_TERM
}

enum MemorySource {
  AUTO
  MANUAL
}

enum IntegrationProvider {
  GMAIL
  GOOGLE_CALENDAR
  SLACK
  NOTION
  LINEAR
  OTHER
}

enum GrantMode {
  ALWAYS
  ASK_EACH
}

enum GrantRequestStatus {
  PENDING
  GRANTED_ONCE
  GRANTED_ALWAYS
  DENIED
}

enum CreditReason {
  MONTHLY_GRANT
  PURCHASE
  TASK_CONSUMPTION
  REFUND
  GIFT
  SIGNUP_BONUS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EDITED
  CANCELLED
  EXPIRED
}

enum UserRating {
  POSITIVE
  NEGATIVE
}

enum ConfidenceBand {
  HIGH
  MEDIUM
  LOW
}

enum AgentPattern {
  COPILOT
  TRIAGE
  TRANSACTION
  MONITOR
  DECISION_SUPPORT
  AUTONOMOUS
}

enum EventType {
  TASK_ASSIGNED
  STEP_STARTED
  TOOL_CALLED
  TOOL_RESULT
  NEEDS_APPROVAL
  APPROVAL_GRANTED
  STEP_COMPLETE
  TASK_COMPLETE
  TASK_FAILED
  TASK_BLOCKED
}

enum OfficeTheme {
  LOFT
  TRADITIONAL
  MODERN
}

enum AmbientSound {
  CITY
  QUIET
  RAIN
  COFFEE_SHOP
}

enum TriggerProvider {
  WHATSAPP
  EMAIL
  SLACK
  GITHUB
  GENERIC
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum SocialPlatform {
  TWITTER
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  TIKTOK
  THREADS
  PINTEREST
}

// ─── MODELS ───────────────────────────────────────────────────────

model User {
  id               String          @id @default(uuid())
  clerkId          String          @unique
  email            String          @unique
  name             String
  avatarUrl        String?
  plan             Plan            @default(FREE)
  byokKey          String?
  byokProvider     ApiKeyProvider?
  creditsRemaining Int             @default(25)
  stripeCustomerId String?         @unique
  onboardingDone       Boolean         @default(false)
  weeklyDigestEnabled  Boolean         @default(true)
  settings             Json?
  freeRunCredits       Int             @default(10)
  lastQuotaResetAt     DateTime?
  isAdmin              Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  office           Office?
  agents           Agent[]
  tasks            Task[]
  integrations     Integration[]
  creditLedger     CreditEntry[]
  savedCommands    SavedCommand[]
  scheduledRuns    ScheduledRun[]
  workflows        Workflow[]
  mcpServers       McpServer[]
  triggerRules     TriggerRule[]
  xpProfile        UserXp?
  xpEvents         XpEvent[]
  achievements     Achievement[]
  stripePayments   StripePayment[]
  teamMemberships  TeamMembership[]
  scheduledPosts   ScheduledPost[]
  llmCallLogs      LlmCallLog[]

  @@index([clerkId])
  @@index([email])
}

model AnomalyAlertLog {
  id        String   @id @default(uuid())
  userId    String
  todayUsd  Float
  avgUsd    Float
  ratio     Float
  sentAt    DateTime @default(now())

  @@index([userId, sentAt])
  @@index([sentAt])
}

model LlmCallLog {
  id                String   @id @default(uuid())
  userId            String
  agentId           String?
  endpoint          String   // e.g. /api/agents/:id/chat, /api/onboarding/compose
  model             String   // e.g. claude-sonnet-4-6
  provider          String   @default("ANTHROPIC")
  byok              Boolean  @default(false)
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  cacheReadTokens   Int      @default(0)
  cacheCreateTokens Int      @default(0)
  estimatedCostUsd  Float    @default(0)
  latencyMs         Int?
  status            String   @default("OK") // OK | ERROR | RATE_LIMITED
  errorMessage      String?
  createdAt         DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Office {
  id           String       @id @default(uuid())
  userId       String       @unique
  name         String       @default("My Office")
  theme        OfficeTheme  @default(LOFT)
  city         String       @default("NYC")
  ambientSound AmbientSound @default(CITY)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents       Agent[]
}

model Agent {
  id                 String             @id @default(uuid())
  officeId           String
  userId             String
  name               String
  role               AgentRole
  systemPrompt       String             @db.Text
  contextBrief       String?            @db.Text
  personality        String?
  avatarUrl          String
  avatarStyle        AvatarStyle
  avatarPresentation AvatarPresentation
  deskPosition       Json
  pattern            AgentPattern       @default(AUTONOMOUS)
  scopeConfig        Json?
  isPublic           Boolean            @default(false)
  status             AgentStatus        @default(IDLE)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  office             Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks              Task[]
  memories           AgentMemory[]
  knowledge          AgentKnowledge[]
  events             TaskEvent[]
  approvalRequests   ApprovalRequest[]
  savedCommands      SavedCommand[]
  triggerRules       TriggerRule[]
  scheduledPosts     ScheduledPost[]
  evolution          AgentEvolution?
  products           AgentProduct[]
  integrationGrants  AgentIntegrationGrant[]
  grantRequests      IntegrationGrantRequest[]

  @@index([userId])
  @@index([officeId])
  @@index([status])
}

model Task {
  id              String          @id @default(uuid())
  agentId         String
  userId          String
  title           String
  rawCommand      String          @db.Text
  status          TaskStatus      @default(PENDING)
  complexity      TaskComplexity  @default(MEDIUM)
  result          Json?
  tokensUsed      Int             @default(0)
  costUsd         Float           @default(0)
  modelUsed       String?
  userRating      UserRating?
  confidence      ConfidenceBand?
  langGraphThread String?         @unique
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  agent           Agent           @relation(fields: [agentId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  steps           TaskStep[]
  events          TaskEvent[]
  toolCalls       ToolCall[]
  approvalRequests ApprovalRequest[]
  creditEntries   CreditEntry[]

  @@index([userId])
  @@index([agentId])
  @@index([status])
  @@index([createdAt])
}

model TaskStep {
  id          String     @id @default(uuid())
  taskId      String
  stepNumber  Int
  name        String
  description String?
  status      StepStatus @default(PENDING)
  input       Json?
  output      Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  toolCalls   ToolCall[]

  @@unique([taskId, stepNumber])
  @@index([taskId])
}

model TaskEvent {
  id             String    @id @default(uuid())
  taskId         String
  agentId        String
  eventType      EventType
  sequenceNumber Int
  payload        Json
  timestamp      DateTime  @default(now())

  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent          Agent     @relation(fields: [agentId], references: [id])

  @@index([taskId, sequenceNumber])
  @@index([agentId])
}

model ToolCall {
  id            String         @id @default(uuid())
  taskId        String
  taskStepId    String?
  integrationId String?
  toolName      String
  input         Json
  output        Json?
  status        ToolCallStatus @default(PENDING)
  retryCount    Int            @default(0)
  durationMs    Int?
  createdAt     DateTime       @default(now())
  completedAt   DateTime?

  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  step          TaskStep?      @relation(fields: [taskStepId], references: [id])
  integration   Integration?   @relation(fields: [integrationId], references: [id])

  @@index([taskId])
  @@index([taskStepId])
}

model AgentMemory {
  id         String       @id @default(uuid())
  agentId    String
  key        String
  value      String       @db.Text
  memoryType MemoryType   @default(LONG_TERM)
  source     MemorySource @default(MANUAL)
  taskId     String?
  confidence Float?
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  agent      Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
  @@index([agentId])
  @@index([expiresAt])
  @@index([taskId])
}

model Integration {
  id                   String              @id @default(uuid())
  userId               String
  provider             IntegrationProvider
  composioAppName      String?
  accessToken          String              @db.Text
  refreshToken         String?             @db.Text
  tokenExpiresAt       DateTime?
  scopes               String[]
  isActive             Boolean             @default(true)
  composioConnectionId String?             @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCalls            ToolCall[]
  agentGrants          AgentIntegrationGrant[]

  @@unique([userId, provider])
  @@unique([userId, composioAppName])
  @@index([userId])
}

model AgentIntegrationGrant {
  id            String    @id @default(uuid())
  agentId       String
  integrationId String
  mode          GrantMode @default(ALWAYS)
  scopes        String[]
  grantedAt     DateTime  @default(now())
  lastUsedAt    DateTime?

  agent         Agent       @relation(fields: [agentId],       references: [id], onDelete: Cascade)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([agentId, integrationId])
  @@index([agentId])
  @@index([integrationId])
}

model IntegrationGrantRequest {
  id              String              @id @default(uuid())
  agentId         String
  composioAppName String
  toolName        String?
  reason          String              @db.Text
  status          GrantRequestStatus  @default(PENDING)
  createdAt       DateTime            @default(now())
  resolvedAt      DateTime?

  agent           Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
  @@index([agentId, composioAppName, status])
}

model ApprovalRequest {
  id            String         @id @default(uuid())
  taskId        String
  agentId       String
  action        String
  preview       Json
  previewType   String
  isDestructive Boolean        @default(true)
  status        ApprovalStatus @default(PENDING)
  userEdit      Json?
  auditHash     String?
  requestedAt   DateTime       @default(now())
  respondedAt   DateTime?
  expiresAt     DateTime

  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent         Agent          @relation(fields: [agentId], references: [id])

  @@index([taskId])
  @@index([status])
  @@index([expiresAt])
}

model SavedCommand {
  id          String   @id @default(uuid())
  userId      String
  agentId     String
  title       String
  rawCommand  String   @db.Text
  runCount    Int      @default(1)
  lastRunAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  schedules   ScheduledRun[]

  @@unique([userId, rawCommand])
  @@index([userId])
  @@index([agentId])
}

model ScheduledRun {
  id             String    @id @default(uuid())
  userId         String
  savedCommandId String
  cronExpr       String
  label          String
  isActive       Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime  @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedCommand   SavedCommand @relation(fields: [savedCommandId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model CreditEntry {
  id          String       @id @default(uuid())
  userId      String
  taskId      String?
  amount      Int
  reason      CreditReason
  description String
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  agentId    String?
  taskId     String?
  action     String
  entityType String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([agentId])
  @@index([taskId])
  @@index([createdAt])
}

model AgentKnowledge {
  id        String   @id @default(uuid())
  agentId   String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())

  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model Workflow {
  id        String        @id @default(uuid())
  userId    String
  name      String
  steps     Json          // Array<{ agentId: string; instruction: string; label: string }>
  status    String        @default("ACTIVE")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]

  @@index([userId])
}

model WorkflowRun {
  id          String    @id @default(uuid())
  workflowId  String
  userId      String
  status      String    @default("RUNNING")
  stepOutputs Json      @default("[]")
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
}

model McpServer {
  id           String    @id @default(uuid())
  userId       String
  name         String
  description  String?
  url          String
  transport    String    @default("http")
  authHeader   String?
  toolCount    Int       @default(0)
  tools        Json      @default("[]")
  isActive     Boolean   @default(true)
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TriggerRule {
  id             String          @id @default(uuid())
  userId         String
  agentId        String
  provider       TriggerProvider
  label          String
  webhookSecret  String          @unique @default(uuid())
  promptTemplate String          @db.Text
  filterField    String?         // 'from' | 'subject' | 'body' | 'channel' | 'event' | 'repo'
  filterOp       String?         // 'contains' | 'equals' | 'startsWith' | 'any'
  filterValue    String?
  isActive       Boolean         @default(true)
  fireCount      Int             @default(0)
  lastFiredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  events         InboundEvent[]

  @@index([userId])
  @@index([webhookSecret])
  @@index([agentId])
}

model InboundEvent {
  id         String       @id @default(uuid())
  ruleId     String
  taskId     String?
  provider   String
  senderInfo String?
  summary    String?
  matched    Boolean      @default(true)
  rawPayload Json
  createdAt  DateTime     @default(now())

  rule       TriggerRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([createdAt])
}

model UserXp {
  id             String    @id @default(uuid())
  userId         String    @unique
  totalXp        Int       @default(0)
  level          Int       @default(1)
  streakDays     Int       @default(0)
  lastActiveDate String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpEvents       XpEvent[]
}

model XpEvent {
  id        String   @id @default(uuid())
  userId    String
  userXpId  String
  xp        Int
  reason    String
  label     String
  refId     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userXp    UserXp   @relation(fields: [userXpId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Achievement {
  id         String   @id @default(uuid())
  userId     String
  key        String
  unlockedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model StripePayment {
  id              String   @id @default(uuid())
  userId          String
  stripeSessionId String   @unique
  stripePaymentId String?
  credits         Int
  amountUsd       Float
  status          String   @default("PENDING") // PENDING | COMPLETE | FAILED
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSessionId])
}

model Team {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  ownerId     String
  avatarUrl   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  memberships TeamMembership[]
  invites     TeamInvite[]

  @@index([ownerId])
}

model TeamMembership {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamInvite {
  id        String    @id @default(uuid())
  teamId    String
  email     String
  role      TeamRole  @default(MEMBER)
  token     String    @unique @default(uuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([token])
  @@index([teamId])
}

model ScheduledPost {
  id          String           @id @default(uuid())
  userId      String
  agentId     String?
  platforms   String[]
  content     String           @db.Text
  mediaUrls   String[]         @default([])
  scheduledAt DateTime
  publishedAt DateTime?
  status      SocialPostStatus @default(SCHEDULED)
  failReason  String?
  results     Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       Agent?           @relation(fields: [agentId], references: [id])

  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
}

// ─── MOAT FEATURES ────────────────────────────────────────────────

model AgentEvolution {
  id            String    @id @default(uuid())
  agentId       String    @unique
  userId        String
  level         Int       @default(1)
  xp            Int       @default(0)
  title         String    @default("Junior")
  skills        Json      @default("[]")
  tasksComplete Int       @default(0)
  lastLevelUpAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BrainNode {
  id             String   @id @default(uuid())
  userId         String
  topic          String
  content        String   @db.Text
  category       String   @default("learning")
  importance     Int      @default(1)
  linkedTaskIds  String[] @default([])
  linkedAgentIds String[] @default([])
  accessCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([category])
}

enum BrainDocumentSource {
  UPLOAD
  URL
}

model BrainDocument {
  id               String              @id @default(uuid())
  userId           String
  name             String              // user-friendly label
  source           BrainDocumentSource
  sourceUrl        String?             @db.Text  // populated for URL ingest
  originalFilename String?             // populated for UPLOAD
  mimeType         String
  sizeBytes        Int                 @default(0)
  extractedText    String              @db.Text  // plain-text extracted body
  summary          String?             @db.Text  // optional auto-generated summary
  accessCount      Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model BusinessObjective {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String?
  metric       String
  targetValue  Float
  currentValue Float    @default(0)
  period       String   @default("monthly")
  dueAt        DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
}

model AutonomousConfig {
  id          String    @id @default(uuid())
  userId      String    @unique
  enabled     Boolean   @default(false)
  briefTime   String    @default("08:00")
  lastBriefAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AgentChemistry {
  id             String    @id @default(uuid())
  userId         String
  agentId1       String
  agentId2       String
  sharedTasks    Int       @default(0)
  successCount   Int       @default(0)
  chemistryScore Float     @default(0)
  lastCollabAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([agentId1, agentId2])
  @@index([userId])
}

model AgentProduct {
  id          String         @id @default(uuid())
  agentId     String
  userId      String
  name        String
  tagline     String
  description String         @db.Text
  category    String         @default("general")
  priceUsd    Float          @default(0)
  isPublished Boolean        @default(false)
  installCount Int           @default(0)
  rating      Float?
  ratingCount Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  agent       Agent          @relation(fields: [agentId], references: [id])
  installs    ProductInstall[]

  @@index([userId])
  @@index([isPublished])
}

model ProductInstall {
  id          String       @id @default(uuid())
  productId   String
  buyerUserId String
  installedAt DateTime     @default(now())

  product     AgentProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, buyerUserId])
  @@index([buyerUserId])
}
