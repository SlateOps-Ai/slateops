# SlateOps — environment variables template
# Copy to .env and fill in values.
# Never commit .env — it's gitignored.
#
# ENVIRONMENTS
#   local/staging → use Neon dev branch URLs + Clerk dev instance keys
#   production    → use Neon production branch URLs + Clerk production keys (set in Railway only)

# ── Database (Neon) ───────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Auth (Clerk) ──────────────────────────────────────────────────
# Dev instance → dashboard.clerk.com → select app → API Keys
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Webhook secret → dashboard.clerk.com → Webhooks → endpoint secret
CLERK_WEBHOOK_SECRET=whsec_xxx

# ── AI ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Integrations ──────────────────────────────────────────────────
# Composio → app.composio.dev → API Keys
COMPOSIO_API_KEY=xxx
# Resend → resend.com → API Keys
RESEND_API_KEY=re_xxx

# ── Security ──────────────────────────────────────────────────────
# Generate: openssl rand -hex 16
ENCRYPTION_KEY=32-char-hex-string

# ── URLs ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
PORT=4000
